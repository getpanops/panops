# xOps Environment Variables
# Copy to .env and fill in your values before starting the stack.

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=CHANGE_ME_strong_password_here

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here
GRAFANA_DOMAIN=localhost

# Optional: email alerts from Grafana
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.YOUR_DOMAIN:587
GRAFANA_SMTP_USER=alerts@YOUR_DOMAIN
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=alerts@YOUR_DOMAIN

# ── Assembler ─────────────────────────────────────────────────────────────────
# dry-run = propose actions but don't execute; enabled = execute remediations
AUTO_REMEDIATION_MODE=dry-run

# ── Notification webhooks (Grafana contact points) ───────────────────────────
# Set these to route NOC/SOC alerts to Slack, Teams, Matrix, PagerDuty, etc.
# Alerts flow: Grafana alert rule → contact point → webhook → your channel.
# If unset, alerts fall back to the assembler webhook endpoint.
NOC_WEBHOOK_URL=
SOC_WEBHOOK_URL=

# ── Image overrides (optional) ────────────────────────────────────────────────
# ASSEMBLER_IMAGE=ghcr.io/getpanops/panops/assembler:latest
# SIGMA_SCANNER_IMAGE=ghcr.io/getpanops/panops/sigma-scanner:latest
# DRAIN3_MINER_IMAGE=ghcr.io/getpanops/panops/drain3-miner:latest
# MEMORY_MCP_IMAGE=ghcr.io/getpanops/panops/memory-mcp:latest
# AGENT_IMAGE=ghcr.io/getpanops/panops/agent:latest

# ── LLM tier (docker-compose.llm.yml) ────────────────────────────────────────
# Option A: BYO external LLM (OpenAI-compatible API)
LLM_EXTERNAL_URL=
LLM_EXTERNAL_TOKEN=

# Option B: local llama-server — place .gguf in deploy/docker-compose/models/
#   then run: docker compose ... --profile local-llm up -d

# ── ML tier (docker-compose.ml.yml) ──────────────────────────────────────────
MCP_MEMORY_URL=http://memory-mcp:8082
